# Public HTTPS front for the workbench MCP. Terminate TLS here, proxy to 127.0.0.1:4036.
server {
    server_name mcp.example.org;

    location /mcp {
        proxy_pass http://127.0.0.1:4036/mcp;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
        # IMPORTANT: rewrite Host to the local bind address. FastMCP's Streamable HTTP
        # transport has DNS-rebinding protection and returns 421 Misdirected Request
        # if the forwarded Host is not an allowed host. Sending 127.0.0.1:4036 passes it.
        proxy_set_header Host 127.0.0.1:4036;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass http://127.0.0.1:4036/health;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    listen 443 ssl;
    # ssl_certificate / ssl_certificate_key managed by your ACME client
}
